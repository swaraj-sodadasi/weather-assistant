# Doxyfile for Weather Assistant Project
# Format: Doxygen configuration file

PROJECT_NAME           = "Weather Assistant"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Voice-Enabled Weather Intelligence Web Application"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English

# Input source settings
INPUT                  = . \
                         weather-information.js \
                         map-information.js \
                         speech-tasks.js \
                         README.md

FILE_PATTERNS          = *.js \
                         *.md

RECURSIVE              = YES
EXCLUDE                = node_modules docs .git _site
EXCLUDE_PATTERNS       = *node_modules* \
                         *docs* \
                         *_site* \
                         *.git*
USE_MDFILE_AS_MAINPAGE = README.md

# Extension & JavaScript settings
EXTENSION_MAPPING      = js=Javascript
OPTIMIZE_OUTPUT_JAVA   = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

# Extraction parameters
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
CASE_SENSE_NAMES       = YES

# Output formats
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

# Warnings and logging
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

# Graphviz / Diagram settings
HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 10
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 50
MAX_DOT_GRAPH_DEPTH    = 0
DOT_TRANSPARENT        = YES
