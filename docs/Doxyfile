# Doxygen Configuration File for Weather Assistant Project
# Comprehensive Live Documentation Settings

PROJECT_NAME           = "Weather Assistant"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Voice-enabled weather intelligence & live mapping dashboard code documentation"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_JAVA   = YES
EXTENSION_MAPPING      = js=Javascript
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

# Live Documentation Extraction Rules
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
CASE_SENSE_NAMES       = YES
SHOW_INCLUDE_FILES     = YES
SORT_MEMBER_DOCS       = YES
MAX_INITIALIZER_LINES  = 30
SHOW_USED_FILES        = YES
SHOW_FILES             = YES

# Input Files to Examine for Live Documentation
INPUT                  = . weather-information.js map-information.js speech-tasks.js index.html index.css README.md
FILE_PATTERNS          = *.js *.md *.html *.css
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */node_modules/* */.git/* */docs/html/* */_site/*

# HTML Output & Live Sidebar Navigation Setup
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
DISABLE_INDEX          = NO

# Other Formats Disabled (Focusing purely on Live HTML Documentation)
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
