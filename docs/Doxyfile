# Doxygen Configuration File for Weather Assistant

PROJECT_NAME           = "Weather Assistant"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Modern Voice-Enabled Weather Intelligence Web Application"
OUTPUT_DIRECTORY       = .
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

# Source Input Files & Documentation Mapping (relative to docs/ folder)
INPUT                  = ../README.md ../weather-information.js ../map-information.js ../speech-tasks.js ../index.html
USE_MDFILE_AS_MAINPAGE = ../README.md
FILE_PATTERNS          = *.js *.md *.html
RECURSIVE              = NO

# Extraction Settings
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_JAVA   = YES
EXTENSION_MAPPING      = js=Javascript html=HTML md=Markdown

# HTML Output Settings
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_PATH_NAMES        = NO

# Disable Unused Formats for Performance
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
